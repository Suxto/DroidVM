+// found in the LICENSE file.
+
+//! A small baseline JPEG encoder for 4:2:0 YUV frames.
+//!
+//! The virtual UVC camera streams MJPEG, so frames coming from the Android
+//! camera (which hands out `YUV_420_888`) have to be turned into JPEG. This
+//! encoder is self contained on purpose: no C library, no extra crate, just
+//! baseline sequential JPEG with optimal Huffman tables that are computed from
+//! the frame itself.
+//!
+//! It is a straight port of the well known IJG structure: forward DCT per 8x8
+//! block, quality scaled quantization tables, then two entropy passes (the
+//! first one collects symbol statistics, the second one emits the data).
+
+/// Luminance quantization table, in natural (row major) order.
+const STD_LUMA_QUANT: [u8; 64] = [
+    16, 11, 10, 16, 24, 40, 51, 61, 12, 12, 14, 19, 26, 58, 60, 55, 14, 13, 16, 24, 40, 57, 69, 56,
+    14, 17, 22, 29, 51, 87, 80, 62, 18, 22, 37, 56, 68, 109, 103, 77, 24, 35, 55, 64, 81, 104, 113,
+    92, 49, 64, 78, 87, 103, 121, 120, 101, 72, 92, 95, 98, 112, 100, 103, 99,
+];
+
+/// Chrominance quantization table, in natural (row major) order.
+const STD_CHROMA_QUANT: [u8; 64] = [
+    17, 18, 24, 47, 99, 99, 99, 99, 18, 21, 26, 66, 99, 99, 99, 99, 24, 26, 56, 99, 99, 99, 99, 99,
+    47, 66, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99,
+    99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99, 99,
+];
+
+/// Maps a zigzag index to the natural (row major) coefficient index.
+const ZIGZAG: [usize; 64] = [
+    0, 1, 8, 16, 9, 2, 3, 10, 17, 24, 32, 25, 18, 11, 4, 5, 12, 19, 26, 33, 40, 48, 41, 34, 27, 20,
+    13, 6, 7, 14, 21, 28, 35, 42, 49, 56, 57, 50, 43, 36, 29, 22, 15, 23, 30, 37, 44, 51, 58, 59,
+    52, 45, 38, 31, 39, 46, 53, 60, 61, 54, 47, 55, 62, 63,
+];
+
+fn scaled_quant_table(base: &[u8; 64], quality: u8) -> [u8; 64] {
+    let quality = quality.clamp(1, 100) as i32;
+    let scale = if quality < 50 {
+        5000 / quality
+    } else {
+        200 - quality * 2
+    };
+    let mut table = [0u8; 64];
+    for (dst, src) in table.iter_mut().zip(base.iter()) {
+        let value = ((i32::from(*src) * scale + 50) / 100).clamp(1, 255);
+        *dst = value as u8;
+    }
+    table
+}
+
+/// Forward DCT cosine table: `COS[u][x]`.
+fn cosine_table() -> [[f32; 8]; 8] {
+    let mut table = [[0f32; 8]; 8];
+    for (u, row) in table.iter_mut().enumerate() {
+        for (x, value) in row.iter_mut().enumerate() {
+            let angle = (2.0 * x as f32 + 1.0) * u as f32 * std::f32::consts::PI / 16.0;
+            let norm = if u == 0 {
+                std::f32::consts::FRAC_1_SQRT_2
+            } else {
+                1.0
+            };
+            *value = 0.5 * norm * angle.cos();
+        }
+    }
+    table
+}
+
+/// Forward DCT of one 8x8 block, output in natural order.
+fn fdct(block: &[f32; 64], cos: &[[f32; 8]; 8], out: &mut [f32; 64]) {
+    let mut temp = [0f32; 64];
+    for y in 0..8 {
+        for u in 0..8 {
+            let mut sum = 0f32;
+            for x in 0..8 {
+                sum += block[y * 8 + x] * cos[u][x];
+            }
+            temp[y * 8 + u] = sum;
+        }
+    }
+    for x in 0..8 {
+        for v in 0..8 {
+            let mut sum = 0f32;
+            for y in 0..8 {
+                sum += temp[y * 8 + x] * cos[v][y];
+            }
+            out[v * 8 + x] = sum;
+        }
+    }
+}
+
+/// Number of bits needed for the magnitude of `value`.
+fn category(value: i32) -> u8 {
+    let mut magnitude = value.unsigned_abs();
+    let mut bits = 0u8;
+    while magnitude != 0 {
+        magnitude >>= 1;
+        bits += 1;
+    }
+    bits
+}
+
+/// A JPEG Huffman table with canonical codes.
+struct HuffTable {
+    bits: [u8; 17],
+    values: Vec<u8>,
+    codes: [(u16, u8); 256],
+}
+
+impl HuffTable {
+    /// Builds a length limited Huffman table from symbol frequencies, the same
+    /// way libjpeg's `jpeg_gen_optimal_table` does.
+    fn from_frequencies(freq: &[i64; 257]) -> HuffTable {
+        // Pseudo symbol 256 keeps the all-ones code free for padding.
+        let original = *freq;
+        let mut freq = original;
+        freq[256] = 1;
+
+        let mut codesize = [0usize; 257];
+        let mut others = [-1i64; 257];
+        loop {
+            let mut c1 = usize::MAX;
+            let mut v1 = i64::MAX;
+            for i in 0..=256 {
+                if freq[i] != 0 && freq[i] <= v1 {
+                    v1 = freq[i];
+                    c1 = i;
+                }
+            }
+            let mut c2 = usize::MAX;
+            let mut v2 = i64::MAX;
+            for i in 0..=256 {
+                if freq[i] != 0 && freq[i] <= v2 && i != c1 {
+                    v2 = freq[i];
+                    c2 = i;
+                }
+            }
+            if c1 == usize::MAX || c2 == usize::MAX {
+                break;
+            }
+            freq[c1] += freq[c2];
+            freq[c2] = 0;
+
+            codesize[c1] += 1;
+            let mut node = c1;
+            while others[node] >= 0 {
+                node = others[node] as usize;
+                codesize[node] += 1;
+            }
+            others[node] = c2 as i64;
+
+            codesize[c2] += 1;
+            let mut node = c2;
+            while others[node] >= 0 {
+                node = others[node] as usize;
+                codesize[node] += 1;
+            }
+        }
+
+        let mut bits = [0u32; 33];
+        for size in codesize.iter() {
+            bits[*size] += 1;
+        }
+
+        // Move symbols out of code lengths above 16, JPEG cannot represent them.
+        for i in (17..=32).rev() {
+            while bits[i] > 0 {
+                let mut j = i - 2;
+                while bits[j] == 0 {
+                    j -= 1;
+                }
+                bits[i] -= 2;
+                bits[i - 1] += 1;
+                bits[j + 1] += 2;
+                bits[j] -= 1;
+            }
+        }
+
+        // Drop the pseudo symbol from the longest code length.
+        let mut longest = 16;
+        while longest > 0 && bits[longest] == 0 {
+            longest -= 1;
+        }
+        bits[longest] -= 1;
+
+        // Assign the final code lengths: shortest codes to the symbols that had
+        // the shortest codes before the length adjustment.
+        let mut symbols: Vec<u8> = (0..=255u8).filter(|s| original[*s as usize] != 0).collect();
+        symbols.sort_by_key(|s| (codesize[*s as usize], *s));
+
+        let mut values = Vec::with_capacity(symbols.len());
+        let mut codes = [(0u16, 0u8); 256];
+        let mut code: u32 = 0;
+        let mut index = 0;
+        for length in 1..=16usize {
+            for _ in 0..bits[length] {
+                if index >= symbols.len() {
+                    break;
+                }
+                let symbol = symbols[index];
+                codes[symbol as usize] = (code as u16, length as u8);
+                values.push(symbol);
+                code += 1;
+                index += 1;
+            }
+            code <<= 1;
+        }
+
+        let mut table_bits = [0u8; 17];
+        for length in 1..=16usize {
+            table_bits[length] = bits[length].min(255) as u8;
+        }
+
+        HuffTable {
+            bits: table_bits,
+            values,
+            codes,
+        }
+    }
+}
+
+/// Bit writer that performs JPEG byte stuffing.
+struct BitWriter {
+    out: Vec<u8>,
+    accumulator: u32,
+    count: u8,
+}
+
+impl BitWriter {
+    fn new(capacity: usize) -> BitWriter {
+        BitWriter {
+            out: Vec::with_capacity(capacity),
+            accumulator: 0,
+            count: 0,
+        }
+    }
+
+    fn write_bits(&mut self, value: u32, length: u8) {
+        if length == 0 {
+            return;
+        }
+        self.accumulator = (self.accumulator << length) | (value & ((1u32 << length) - 1));
+        self.count += length;
+        while self.count >= 8 {
+            let byte = ((self.accumulator >> (self.count - 8)) & 0xff) as u8;
+            self.out.push(byte);
+            if byte == 0xff {
+                self.out.push(0x00);
+            }
+            self.count -= 8;
+        }
+        if self.count == 0 {
+            self.accumulator = 0;
+        } else {
+            self.accumulator &= (1u32 << self.count) - 1;
+        }
+    }
+
+    fn write_symbol(&mut self, table: &HuffTable, symbol: u8) {
+        let (code, length) = table.codes[symbol as usize];
+        self.write_bits(u32::from(code), length);
+    }
+
+    fn write_value(&mut self, value: i32, category: u8) {
+        if category == 0 {
+            return;
+        }
+        let bits = if value < 0 {
+            (value + (1 << category) - 1) as u32
+        } else {
+            value as u32
+        };
+        self.write_bits(bits, category);
+    }
+
+    fn flush(&mut self) {
+        if self.count > 0 {
+            let padding = 8 - self.count;
+            self.write_bits((1 << padding) - 1, padding);
+        }
+    }
+}
+
+/// A block of quantized coefficients, in zigzag order.
+type Coefficients = [i16; 64];
+
+struct Plane {
+    data: Vec<u8>,
+    stride: usize,
+    width: usize,
+    height: usize,
+}
+
+impl Plane {
+    fn pixel(&self, x: usize, y: usize) -> u8 {
+        let x = x.min(self.width.saturating_sub(1));
+        let y = y.min(self.height.saturating_sub(1));
+        self.data[y * self.stride + x]
+    }
+}
+
+fn extract_plane(
+    data: &[u8],
+    stride: usize,
+    width: usize,
+    height: usize,
+    pad_width: usize,
+    pad_height: usize,
+) -> Plane {
+    let source = Plane {
+        data: data.to_vec(),
+        stride,
+        width,
+        height,
+    };
+    let mut padded = vec![0u8; pad_width * pad_height];
+    for y in 0..pad_height {
+        for x in 0..pad_width {
+            padded[y * pad_width + x] = source.pixel(x, y);
+        }
+    }
+    Plane {
+        data: padded,
+        stride: pad_width,
+        width: pad_width,
+        height: pad_height,
+    }
+}
+
+/// Reads one 8x8 block of an already subsampled chroma plane.
+fn chroma_block(plane: &Plane, x0: usize, y0: usize) -> [f32; 64] {
+    let mut block = [0f32; 64];
+    for y in 0..8 {
+        for x in 0..8 {
+            block[y * 8 + x] = f32::from(plane.pixel(x0 + x, y0 + y)) - 128.0;
+        }
+    }
+    block
+}
+
+fn luma_block(plane: &Plane, x0: usize, y0: usize) -> [f32; 64] {
+    let mut block = [0f32; 64];
+    for y in 0..8 {
+        for x in 0..8 {
+            block[y * 8 + x] = f32::from(plane.pixel(x0 + x, y0 + y)) - 128.0;
+        }
+    }
+    block
+}
+
+fn quantize(
+    block: &[f32; 64],
+    cos: &[[f32; 8]; 8],
+    quant: &[u8; 64],
+    out: &mut Coefficients,
+) {
+    let mut dct = [0f32; 64];
+    fdct(block, cos, &mut dct);
+    for zigzag in 0..64 {
+        let natural = ZIGZAG[zigzag];
+        let value = dct[natural] / f32::from(quant[natural]);
+        out[zigzag] = value.round().clamp(-1023.0, 1023.0) as i16;
+    }
+}
+
+
+fn encode_frame(
+    width: usize,
+    height: usize,
+    quality: u8,
+    luma_data: &[u8],
+    luma_stride: usize,
+    u_data: &[u8],
+    u_stride: usize,
+    v_data: &[u8],
+    v_stride: usize,
+) -> Option<Vec<u8>> {
+    if width == 0 || height == 0 || width % 2 != 0 || height % 2 != 0 {
+        return None;
+    }
+    let pad_width = (width + 15) & !15;
+    let pad_height = (height + 15) & !15;
+    let luma = extract_plane(luma_data, luma_stride, width, height, pad_width, pad_height);
+    let cb_plane = extract_plane(u_data, u_stride, width / 2, height / 2, pad_width / 2, pad_height / 2);
+    let cr_plane = extract_plane(v_data, v_stride, width / 2, height / 2, pad_width / 2, pad_height / 2);
+
+    let cos = cosine_table();
+    let luma_quant = scaled_quant_table(&STD_LUMA_QUANT, quality);
+    let chroma_quant = scaled_quant_table(&STD_CHROMA_QUANT, quality);
+
+    let mcus_x = pad_width / 16;
+    let mcus_y = pad_height / 16;
+
+    let mut luma_blocks: Vec<Coefficients> = Vec::with_capacity(mcus_x * mcus_y * 4);
+    let mut cb_blocks: Vec<Coefficients> = Vec::with_capacity(mcus_x * mcus_y);
+    let mut cr_blocks: Vec<Coefficients> = Vec::with_capacity(mcus_x * mcus_y);
+
+    for my in 0..mcus_y {
+        for mx in 0..mcus_x {
+            let x0 = mx * 16;
+            let y0 = my * 16;
+            for (dx, dy) in [(0, 0), (8, 0), (0, 8), (8, 8)] {
+                let block = luma_block(&luma, x0 + dx, y0 + dy);
+                let mut coefficients = [0i16; 64];
+                quantize(&block, &cos, &luma_quant, &mut coefficients);
+                luma_blocks.push(coefficients);
+            }
+            let block = chroma_block(&cb_plane, x0 / 2, y0 / 2);
+            let mut coefficients = [0i16; 64];
+            quantize(&block, &cos, &chroma_quant, &mut coefficients);
+            cb_blocks.push(coefficients);
+
+            let block = chroma_block(&cr_plane, x0 / 2, y0 / 2);
+            let mut coefficients = [0i16; 64];
+            quantize(&block, &cos, &chroma_quant, &mut coefficients);
+            cr_blocks.push(coefficients);
+        }
+    }
+
+    // Pass one: gather symbol statistics for the optimal Huffman tables.
+    let mut dc_luma_freq = [0i64; 257];
+    let mut ac_luma_freq = [0i64; 257];
+    let mut dc_chroma_freq = [0i64; 257];
+    let mut ac_chroma_freq = [0i64; 257];
+
+    for (index, block) in luma_blocks.iter().enumerate() {
+        let previous = if index == 0 {
+            0
+        } else {
+            luma_blocks[index - 1][0] as i32
+        };
+        collect_block(
+            block,
+            previous,
+            &mut dc_luma_freq,
+            &mut ac_luma_freq,
+        );
+    }
+    for (index, block) in cb_blocks.iter().enumerate() {
+        let previous = if index == 0 { 0 } else { cb_blocks[index - 1][0] as i32 };
+        collect_block(block, previous, &mut dc_chroma_freq, &mut ac_chroma_freq);
+    }
+    for (index, block) in cr_blocks.iter().enumerate() {
+        let previous = if index == 0 { 0 } else { cr_blocks[index - 1][0] as i32 };
+        collect_block(block, previous, &mut dc_chroma_freq, &mut ac_chroma_freq);
+    }
+
+    let dc_luma = HuffTable::from_frequencies(&dc_luma_freq);
+    let ac_luma = HuffTable::from_frequencies(&ac_luma_freq);
+    let dc_chroma = HuffTable::from_frequencies(&dc_chroma_freq);
+    let ac_chroma = HuffTable::from_frequencies(&ac_chroma_freq);
+
+    let mut out: Vec<u8> = Vec::with_capacity(width * height / 4);
+    out.extend_from_slice(&[0xff, 0xd8]); // SOI
+
+    // APP0 / JFIF header.
+    out.extend_from_slice(&[0xff, 0xe0, 0x00, 0x10]);
+    out.extend_from_slice(b"JFIF\0");
+    out.extend_from_slice(&[0x01, 0x01, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x00]);
+
+    // Quantization tables.
+    for (id, table) in [(0u8, &luma_quant), (1u8, &chroma_quant)] {
+        out.extend_from_slice(&[0xff, 0xdb, 0x00, 0x43, id]);
+        let mut zigzag_table = [0u8; 64];
+        for zigzag in 0..64 {
+            zigzag_table[zigzag] = table[ZIGZAG[zigzag]];
+        }
+        out.extend_from_slice(&zigzag_table);
+    }
+
+    // Frame header: baseline, 4:2:0, three components.
+    out.extend_from_slice(&[0xff, 0xc0, 0x00, 0x11, 0x08]);
+    out.extend_from_slice(&(height as u16).to_be_bytes());
+    out.extend_from_slice(&(width as u16).to_be_bytes());
+    out.push(3);
+    out.extend_from_slice(&[1, 0x22, 0x00]);
+    out.extend_from_slice(&[2, 0x11, 0x01]);
+    out.extend_from_slice(&[3, 0x11, 0x01]);
+
+    // Huffman tables: DC luma 0x00, AC luma 0x10, DC chroma 0x01, AC chroma 0x11.
+    for (class_id, table) in [(0x00u8, &dc_luma), (0x10u8, &ac_luma), (0x01u8, &dc_chroma), (0x11u8, &ac_chroma)] {
+        let mut payload: Vec<u8> = Vec::with_capacity(17 + table.values.len());
+        payload.push(class_id);
+        payload.extend_from_slice(&table.bits[1..17]);
+        payload.extend_from_slice(&table.values);
+        out.extend_from_slice(&[0xff, 0xc4]);
+        out.extend_from_slice(&((payload.len() + 2) as u16).to_be_bytes());
+        out.extend_from_slice(&payload);
+    }
+
+    // Scan header.
+    out.extend_from_slice(&[0xff, 0xda, 0x00, 0x0c, 0x03]);
+    out.extend_from_slice(&[1, 0x00]);
+    out.extend_from_slice(&[2, 0x11]);
+    out.extend_from_slice(&[3, 0x11]);
+    out.extend_from_slice(&[0x00, 0x3f, 0x00]);
+
+    let mut writer = BitWriter::new(width * height / 4);
+    let mut previous_dc = [0i32; 3];
+    for index in 0..luma_blocks.len() {
+        let block = &luma_blocks[index];
+        write_block(
+            &mut writer,
+            block,
+            &mut previous_dc[0],
+            &dc_luma,
+            &ac_luma,
+        );
+        if index % 4 == 3 {
+            let mcu = index / 4;
+            write_block(&mut writer, &cb_blocks[mcu], &mut previous_dc[1], &dc_chroma, &ac_chroma);
+            write_block(&mut writer, &cr_blocks[mcu], &mut previous_dc[2], &dc_chroma, &ac_chroma);
+        }
+    }
+    writer.flush();
+    out.extend_from_slice(&writer.out);
+    out.extend_from_slice(&[0xff, 0xd9]); // EOI
+    Some(out)
+}
+
+fn collect_block(
+    block: &Coefficients,
+    previous_dc: i32,
+    dc_freq: &mut [i64; 257],
+    ac_freq: &mut [i64; 257],
+) {
+    let difference = i32::from(block[0]) - previous_dc;
+    dc_freq[category(difference) as usize] += 1;
+    let mut run = 0usize;
+    for zigzag in 1..64 {
+        let value = i32::from(block[zigzag]);
+        if value == 0 {
+            run += 1;
+            continue;
+        }
+        while run > 15 {
+            ac_freq[0xf0] += 1;
+            run -= 16;
+        }
+        ac_freq[(run << 4) | category(value) as usize] += 1;
+        run = 0;
+    }
+    if run > 0 {
+        ac_freq[0x00] += 1;
+    }
+}
+
+fn write_block(
+    writer: &mut BitWriter,
+    block: &Coefficients,
+    previous_dc: &mut i32,
+    dc_table: &HuffTable,
+    ac_table: &HuffTable,
+) {
+    let difference = i32::from(block[0]) - *previous_dc;
+    *previous_dc = i32::from(block[0]);
+    let dc_category = category(difference);
+    writer.write_symbol(dc_table, dc_category);
+    writer.write_value(difference, dc_category);
+
+    let mut run = 0u8;
+    for zigzag in 1..64 {
+        let value = i32::from(block[zigzag]);
+        if value == 0 {
+            run += 1;
+            continue;
+        }
+        while run > 15 {
+            writer.write_symbol(ac_table, 0xf0);
+            run -= 16;
+        }
+        let ac_category = category(value);
+        writer.write_symbol(ac_table, (run << 4) | ac_category);
+        writer.write_value(value, ac_category);
+        run = 0;
+    }
+    if run > 0 {
+        writer.write_symbol(ac_table, 0x00);
+    }
+}
+
+/// Encodes a `YUV_420_888` frame (three planes with their own row strides) into
+/// a baseline JPEG image.
+pub fn encode_yuv420(
+    width: usize,
+    height: usize,
+    quality: u8,
+    y: &[u8],
+    y_stride: usize,
+    u: &[u8],
+    u_stride: usize,
+    v: &[u8],
+    v_stride: usize,
+) -> Option<Vec<u8>> {
+    encode_frame(
+        width, height, quality, y, y_stride, u, u_stride, v, v_stride,
+    )
+}
diff --git a/devices/src/usb/backend/uvc_backend/mediacodec.rs b/devices/src/usb/backend/uvc_backend/mediacodec.rs
new file mode 100644
index 0000000..47e7f41
--- /dev/null
+++ b/devices/src/usb/backend/uvc_backend/mediacodec.rs
@@ -0,0 +1,355 @@
+// Copyright 2026 The crosvm Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+//! Hardware JPEG frame source for the emulated camera.
+//!
+//! The phone's camera pipeline can render straight into a MediaCodec JPEG
+//! encoder surface, which is far faster than the software encoder in
+//! [`super::jpeg`]: one 1080p frame costs about 150 ms on the CPU but only a few
+//! milliseconds in hardware, which is what 1080p60 needs.
+//!
+//! The media stack is loaded with `dlopen`, exactly like the camera bindings, so
+//! a device without a JPEG encoder just falls back to the software path.
+
+use std::ffi::{c_char, c_int, c_void, CString};
+use std::sync::OnceLock;
+
+use base::info;
+
+const RTLD_NOW: c_int = 2;
+
+extern "C" {
+    fn dlopen(filename: *const c_char, flag: c_int) -> *mut c_void;
+    fn dlsym(handle: *mut c_void, symbol: *const c_char) -> *mut c_void;
+}
+
+/// A `dlopen`ed shared library.
+struct Lib {
+    handle: *mut c_void,
+}
+
+impl Lib {
+    fn open(name: &str) -> Option<Lib> {
+        let cname = CString::new(name).ok()?;
+        // SAFETY: `cname` is a valid NUL terminated string.
+        let handle = unsafe { dlopen(cname.as_ptr(), RTLD_NOW) };
+        if handle.is_null() {
+            None
+        } else {
+            Some(Lib { handle })
+        }
+    }
+
+    fn sym(&self, name: &str) -> Option<*mut c_void> {
+        let cname = CString::new(name).ok()?;
+        // SAFETY: `self.handle` comes from a successful `dlopen`.
+        let pointer = unsafe { dlsym(self.handle, cname.as_ptr()) };
+        if pointer.is_null() {
+            None
+        } else {
+            Some(pointer)
+        }
+    }
+}
+
+macro_rules! bind {
+    ($lib:expr, $out:ident, $name:literal, $ty:ty) => {
+        let $out: $ty = match $lib.sym($name) {
+            // SAFETY: the symbol exists and its declared signature matches the
+            // NDK media C API.
+            Some(pointer) => unsafe { std::mem::transmute::<*mut c_void, $ty>(pointer) },
+            None => return None,
+        };
+    };
+}
+
+/// `AMediaFormat` is an opaque handle.
+type AMediaFormat = c_void;
+/// `AMediaCodec` is an opaque handle.
+type AMediaCodec = c_void;
+
+#[repr(C)]
+struct BufferInfo {
+    offset: i32,
+    size: i32,
+    presentation_time_us: i64,
+    flags: u32,
+}
+
+/// `COLOR_FormatSurface`: the input format of a surface fed encoder.
+const COLOR_FORMAT_SURFACE: i32 = 0x7f00_0789;
+const CONFIGURE_FLAG_ENCODE: u32 = 1;
+const BUFFER_FLAG_CODEC_CONFIG: u32 = 2;
+const INFO_TRY_AGAIN_LATER: isize = -1;
+const INFO_OUTPUT_FORMAT_CHANGED: isize = -2;
+const INFO_OUTPUT_BUFFERS_CHANGED: isize = -3;
+
+struct Api {
+    _lib: Lib,
+    codec_create_encoder_by_type: unsafe extern "C" fn(*const c_char) -> *mut AMediaCodec,
+    codec_configure: unsafe extern "C" fn(
+        *mut AMediaCodec,
+        *const AMediaFormat,
+        *mut c_void,
+        *mut c_void,
+        u32,
+    ) -> i32,
+    codec_create_input_surface: unsafe extern "C" fn(*mut AMediaCodec, *mut *mut c_void) -> i32,
+    codec_start: unsafe extern "C" fn(*mut AMediaCodec) -> i32,
+    codec_stop: unsafe extern "C" fn(*mut AMediaCodec) -> i32,
+    codec_dequeue_output: unsafe extern "C" fn(*mut AMediaCodec, *mut BufferInfo, i64) -> isize,
+    codec_get_output_buffer: unsafe extern "C" fn(*mut AMediaCodec, usize, *mut usize) -> *mut u8,
+    codec_release_output: unsafe extern "C" fn(*mut AMediaCodec, usize, bool) -> i32,
+    format_new: unsafe extern "C" fn() -> *mut AMediaFormat,
+    format_delete: unsafe extern "C" fn(*mut AMediaFormat),
+    format_set_int32: unsafe extern "C" fn(*mut AMediaFormat, *const c_char, i32) -> i32,
+    format_set_string: unsafe extern "C" fn(*mut AMediaFormat, *const c_char, *const c_char) -> i32,
+}
+
+// SAFETY: the resolved function pointers are immutable and the library stays
+// loaded for the lifetime of the process.
+unsafe impl Send for Api {}
+unsafe impl Sync for Api {}
+
+fn api() -> Option<&'static Api> {
+    static API: OnceLock<Option<Api>> = OnceLock::new();
+    API.get_or_init(|| {
+        let lib = Lib::open("libmediandk.so")?;
+        bind!(
+            lib,
+            codec_create_encoder_by_type,
+            "AMediaCodec_createEncoderByType",
+            unsafe extern "C" fn(*const c_char) -> *mut AMediaCodec
+        );
+        bind!(
+            lib,
+            codec_configure,
+            "AMediaCodec_configure",
+            unsafe extern "C" fn(
+                *mut AMediaCodec,
+                *const AMediaFormat,
+                *mut c_void,
+                *mut c_void,
+                u32
+            ) -> i32
+        );
+        bind!(
+            lib,
+            codec_create_input_surface,
+            "AMediaCodec_createInputSurface",
+            unsafe extern "C" fn(*mut AMediaCodec, *mut *mut c_void) -> i32
+        );
+        bind!(
+            lib,
+            codec_start,
+            "AMediaCodec_start",
+            unsafe extern "C" fn(*mut AMediaCodec) -> i32
+        );
+        bind!(
+            lib,
+            codec_stop,
+            "AMediaCodec_stop",
+            unsafe extern "C" fn(*mut AMediaCodec) -> i32
+        );
+        bind!(
+            lib,
+            codec_dequeue_output,
+            "AMediaCodec_dequeueOutputBuffer",
+            unsafe extern "C" fn(*mut AMediaCodec, *mut BufferInfo, i64) -> isize
+        );
+        bind!(
+            lib,
+            codec_get_output_buffer,
+            "AMediaCodec_getOutputBuffer",
+            unsafe extern "C" fn(*mut AMediaCodec, usize, *mut usize) -> *mut u8
+        );
+        bind!(
+            lib,
+            codec_release_output,
+            "AMediaCodec_releaseOutputBuffer",
+            unsafe extern "C" fn(*mut AMediaCodec, usize, bool) -> i32
+        );
+        bind!(
+            lib,
+            format_new,
+            "AMediaFormat_new",
+            unsafe extern "C" fn() -> *mut AMediaFormat
+        );
+        bind!(
+            lib,
+            format_delete,
+            "AMediaFormat_delete",
+            unsafe extern "C" fn(*mut AMediaFormat)
+        );
+        bind!(
+            lib,
+            format_set_int32,
+            "AMediaFormat_setInt32",
+            unsafe extern "C" fn(*mut AMediaFormat, *const c_char, i32) -> i32
+        );
+        bind!(
+            lib,
+            format_set_string,
+            "AMediaFormat_setString",
+            unsafe extern "C" fn(*mut AMediaFormat, *const c_char, *const c_char) -> i32
+        );
+        Some(Api {
+            _lib: lib,
+            codec_create_encoder_by_type,
+            codec_configure,
+            codec_create_input_surface,
+            codec_start,
+            codec_stop,
+            codec_dequeue_output,
+            codec_get_output_buffer,
+            codec_release_output,
+            format_new,
+            format_delete,
+            format_set_int32,
+            format_set_string,
+        })
+    })
+    .as_ref()
+}
+
+fn log(line: &str) {
+    info!("uvc: {line}");
+}
+
+/// Hardware JPEG encoder fed by the camera.
+pub struct JpegEncoder {
+    codec: *mut AMediaCodec,
+    surface: *mut c_void,
+    info: BufferInfo,
+    frames: u64,
+}
+
+// SAFETY: the handle is only touched from the capture thread.
+unsafe impl Send for JpegEncoder {}
+
+impl JpegEncoder {
+    /// Builds a JPEG encoder whose input surface the camera can render into.
+    pub fn create(width: i32, height: i32, quality: i32) -> Option<JpegEncoder> {
+        let api = api()?;
+        let mime = CString::new("image/jpeg").ok()?;
+        // SAFETY: every call follows the NDK media contract; failures are
+        // reported through status codes and mapped to `None`.
+        unsafe {
+            let codec = (api.codec_create_encoder_by_type)(mime.as_ptr());
+            if codec.is_null() {
+                log("encoder: no image/jpeg encoder");
+                return None;
+            }
+            let format = (api.format_new)();
+            if format.is_null() {
+                log("encoder: AMediaFormat_new failed");
+                return None;
+            }
+            let key_mime = CString::new("mime").ok()?;
+            let key_width = CString::new("width").ok()?;
+            let key_height = CString::new("height").ok()?;
+            let key_color = CString::new("color-format").ok()?;
+            let key_quality = CString::new("quality").ok()?;
+            (api.format_set_string)(format, key_mime.as_ptr(), mime.as_ptr());
+            (api.format_set_int32)(format, key_width.as_ptr(), width);
+            (api.format_set_int32)(format, key_height.as_ptr(), height);
+            (api.format_set_int32)(format, key_color.as_ptr(), COLOR_FORMAT_SURFACE);
+            (api.format_set_int32)(format, key_quality.as_ptr(), quality);
+            let status = (api.codec_configure)(
+                codec,
+                format,
+                std::ptr::null_mut(),
+                std::ptr::null_mut(),
+                CONFIGURE_FLAG_ENCODE,
+            );
+            (api.format_delete)(format);
+            if status != 0 {
+                log(&format!("encoder: configure failed status={status}"));
+                return None;
+            }
+            let mut surface: *mut c_void = std::ptr::null_mut();
+            let status = (api.codec_create_input_surface)(codec, &mut surface);
+            if status != 0 || surface.is_null() {
+                log(&format!("encoder: createInputSurface failed status={status}"));
+                return None;
+            }
+            let status = (api.codec_start)(codec);
+            if status != 0 {
+                log(&format!("encoder: start failed status={status}"));
+                return None;
+            }
+            log(&format!(
+                "encoder: jpeg {width}x{height} quality={quality} ready"
+            ));
+            Some(JpegEncoder {
+                codec,
+                surface,
+                info: BufferInfo {
+                    offset: 0,
+                    size: 0,
+                    presentation_time_us: 0,
+                    flags: 0,
+                },
+                frames: 0,
+            })
+        }
+    }
+
+    /// Window the camera should render into.
+    pub fn surface(&self) -> *mut c_void {
+        self.surface
+    }
+
+    /// Number of JPEG frames produced so far.
+    pub fn frames(&self) -> u64 {
+        self.frames
+    }
+
+    /// Drains finished frames and returns the newest JPEG, if any.
+    pub fn poll(&mut self) -> Option<Vec<u8>> {
+        let api = api()?;
+        loop {
+            // SAFETY: `codec` is live and `info` is a valid out-parameter.
+            let index = unsafe { (api.codec_dequeue_output)(self.codec, &mut self.info, 0) };
+            if index >= 0 {
+                let index = index as usize;
+                let mut size = 0usize;
+                // SAFETY: the buffer stays valid until it is released below.
+                let data = unsafe { (api.codec_get_output_buffer)(self.codec, index, &mut size) };
+                let skip = self.info.flags & BUFFER_FLAG_CODEC_CONFIG != 0;
+                let jpeg = if !data.is_null() && size > 0 && !skip {
+                    // SAFETY: `data` points at `size` readable bytes.
+                    let slice = unsafe { std::slice::from_raw_parts(data, size) };
+                    self.frames += 1;
+                    Some(slice.to_vec())
+                } else {
+                    None
+                };
+                unsafe { (api.codec_release_output)(self.codec, index, false) };
+                if jpeg.is_some() {
+                    return jpeg;
+                }
+                continue;
+            }
+            if index == INFO_OUTPUT_FORMAT_CHANGED || index == INFO_OUTPUT_BUFFERS_CHANGED {
+                continue;
+            }
+            if index == INFO_TRY_AGAIN_LATER {
+                return None;
+            }
+            return None;
+        }
+    }
+}
+
+impl Drop for JpegEncoder {
+    fn drop(&mut self) {
+        if let Some(api) = api() {
+            // SAFETY: the codec is owned by `self` and stopped once.
+            unsafe {
+                (api.codec_stop)(self.codec);
+            }
+        }
+    }
+}
